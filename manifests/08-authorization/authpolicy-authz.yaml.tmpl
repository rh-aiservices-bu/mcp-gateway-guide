apiVersion: kuadrant.io/v1
kind: AuthPolicy
metadata:
  name: mcp-authz-policy
  namespace: mcp-gateway
spec:
  targetRef:
    group: gateway.networking.k8s.io
    kind: Gateway
    name: mcp-gateway
    sectionName: mcps
  rules:
    authentication:
      "keycloak":
        jwt:
          issuerUrl: ${KEYCLOAK_ISSUER}
    authorization:
      "tool-access-check":
        when:
          - predicate: "request.headers.exists(h, h == 'x-mcp-toolname')"
          - predicate: "request.headers['x-mcp-method'] == 'tools/call'"
        patternMatching:
          patterns:
            - predicate: |
                ('tool:' + request.headers['x-mcp-toolname']) in (has(auth.identity.resource_access) && auth.identity.resource_access.exists(p, p == request.headers['x-mcp-servername']) ? auth.identity.resource_access[request.headers['x-mcp-servername']].roles : [])
    response:
      unauthorized:
        body:
          value: |
            {
              "jsonrpc": "2.0",
              "error": {
                "code": -32600,
                "message": "Forbidden: Insufficient permissions for this tool."
              }
            }
