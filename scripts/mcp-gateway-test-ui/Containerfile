FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir streamlit==1.45.1 requests==2.32.3
COPY mcp-gateway-ui.py .
EXPOSE 8501
ENTRYPOINT ["python", "-m", "streamlit", "run", "mcp-gateway-ui.py", \
            "--server.address=0.0.0.0", "--server.port=8501", \
            "--server.headless=true", "--"]
